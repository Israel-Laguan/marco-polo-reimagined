% book.latex: pandoc template for the print build (S-08). One PDF per volume.
% Trim 6 x 9 in; text block 4.5 x 7.2 in (plate sizes in illustration-style-guide.md depend on it).
\documentclass[11pt,twoside,openright]{book}
\usepackage[paperwidth=6in,paperheight=9in,textwidth=4.5in,textheight=7.2in,
  inner=0.75in,top=0.8in,headsep=0.25in,footskip=0.4in]{geometry}

% Fonts: Noto Serif (ʿ ā ṭ ḥ, Greek, true italic; pairs with Noto Serif CJK); glyphs it lacks fall back to
% DejaVu Sans (✓ ✗ ◇ ≠ ↔) and Noto Serif CJK (Chinese in Notes and tables).
\usepackage{fontspec}
\directlua{luaotfload.add_fallback("bookfallback",
  {"DejaVu Sans:mode=harf;", "Noto Serif CJK SC:mode=harf;"})}
\setmainfont{Noto Serif}[RawFeature={fallback=bookfallback}]
\newfontfamily\markerfont{DejaVu Sans}[Scale=0.9]
\usepackage[final]{microtype}
\setlength{\emergencystretch}{1.5em} % narrow measure: Notes carry long names and keys

\usepackage{graphicx}
% figures at natural size, shrunk only to fit: generated maps and diagrams are made at final
% size (S-09); a raster's natural size comes from its dpi tag
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.75\textheight 0.75\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\usepackage{longtable,booktabs,array,calc,etoolbox}
\AtBeginEnvironment{longtable}{\small}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\usepackage{xcolor}
\usepackage{tcolorbox}

\usepackage[authordate,backend=biber,noibid,isbn=false,doi=false,url=false]{biblatex-chicago}
% base text: the siglum stands alone and takes its locator after a space, "(YC 2.8)",
% "(YC Intro. § 54)", not "(YC 1903, 2.8)" (S-24)
\AtEveryCitekey{\iffieldundef{shorthand}{}{\togglefalse{cms@los}}}
\let\cmspostnotedelim\postnotedelim
\renewcommand*{\postnotedelim}{\iffieldundef{shorthand}{\cmspostnotedelim}{\setunit{\addspace}}}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$

\usepackage[hidelinks]{hyperref}
\setcounter{secnumdepth}{-1}
\setcounter{tocdepth}{0}
\pagestyle{myheadings}
\usepackage[fit]{truncate} % long chapter titles: running head ends in an ellipsis

% ---- conventions (see plans/registry/markdown-conventions.md) ----
% # Chapter II-2 + ## Title
\newcommand\bookchapter[2]{\cleardoublepage\thispagestyle{plain}\markboth{\truncate{0.85\textwidth}{#2}}{\truncate{0.85\textwidth}{#2}}%
  \vspace*{3\baselineskip}%
  \if\relax\detokenize{#1}\relax\else{\centering\scshape Chapter #1\par}\vspace{0.6\baselineskip}\fi
  {\centering\LARGE #2\par}\vspace{2\baselineskip}%
  \addcontentsline{toc}{chapter}{\if\relax\detokenize{#1}\relax\else #1\quad\fi #2}}
% **[M]** tag line
\newcommand\chaptertag[1]{{\centering\scshape [#1]\par}\bigskip}
% > *"quote"* / > — credit
\newenvironment{epigraphq}{\begin{flushright}\begin{minipage}{0.78\linewidth}\small\raggedright}
  {\end{minipage}\end{flushright}\bigskip}
\newcommand\epicredit[1]{\par\smallskip{\raggedleft\footnotesize — #1\par}}
% paragraph opening "— " (an aside)
\newenvironment{aside}{\begin{list}{}{\leftmargin=1.5em\rightmargin=0pt\topsep=0.6ex}\item\relax\small}
  {\end{list}}
% a --- that is not structural
\newcommand\scenebreak{\par\medskip{\centering *\quad*\quad*\par}\medskip}
% ::: howto
\newtcolorbox{howto}{colback=white,colframe=black!55,boxrule=0.4pt,arc=0pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,fontupper=\small}
% an image the build could not place (see book.lua)
\newcommand\figplaceholder[2]{\fbox{\parbox[c][0.3\textheight][c]{0.95\linewidth}{\centering\footnotesize
  \texttt{#1}\\[0.5ex] #2}}}
% [n] in the body, and ## Notes
\newcommand\notemark[2]{\textsuperscript{\hyperlink{n#1-#2}{#2}}}
\newcommand\notesheading{\section*{Notes}}
\newenvironment{chapternotes}{\small\begin{list}{}{\leftmargin=1.8em\labelwidth=1.5em
  \labelsep=0.3em\itemsep=0.4ex\parsep=0pt\topsep=0pt}}{\end{list}}
\newcommand\noteitem[2]{\item[\hypertarget{n#1-#2}{#2}.]}
% Note markers ✓ ~ ✗ ◇ ? at clause start
\newcommand\mk[1]{{\markerfont\char#1}}

% Put the reader's locator key inside the heading of the generated shorthand list.
\defbibheading{abbreviations}[Abbreviations]{%
  \chapter*{#1}%
  \textbf{YC} refers to Henry Yule's translation of Marco Polo, third edition,
  revised by Henri Cordier (1903). \textbf{YC Add.} refers to Cordier's
  \emph{Notes and Addenda} (1920). The Project Gutenberg editions are the copies
  consulted, not the dates of the original books.\par\medskip
  In a reference such as \textbf{YC 1.61}, the first number is the book and the
  second is the chapter: this is Book I, Chapter LXI in Yule's text.
  \textbf{YC Prol. 17--18} means Prologue chapters XVII--XVIII. An \textbf{n.}
  followed by a number refers to Yule's note to that chapter; \textbf{Intro. §}
  refers to a section of his Introduction.\par\medskip
}

\begin{document}
\frontmatter
\tableofcontents
\printbiblist[heading=abbreviations,title={Abbreviations}]{shorthand}
\mainmatter
$body$
\backmatter
\printbibliography[title={Works cited}]
\end{document}
